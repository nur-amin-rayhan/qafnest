# Browser-safe Supabase configuration. Point this at the isolated DEV project.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here
NEXT_PUBLIC_SUPABASE_OTP_LENGTH=6

# CMS app URL and ecosystem navigation links.
NEXT_PUBLIC_SITE_URL=http://localhost:3002/cms
NEXT_PUBLIC_GUEST_URL=http://localhost:3000
NEXT_PUBLIC_HOST_PORTAL_URL=http://localhost:3001
NEXT_PUBLIC_CMS_PORTAL_URL=http://localhost:3002/cms
NEXT_PUBLIC_ADMIN_PORTAL_URL=http://localhost:3003/admin

# Contact Us Form & CMS Gmail Test Delivery (qafnest@gmail.com)
GMAIL_USER=qafnest@gmail.com
GMAIL_APP_PASSWORD=
CONTACT_FROM_EMAIL=qafnest@gmail.com

# Server-only key used by the protected CMS review/approval API.
# Paste the test project's service_role key (or modern sb_secret_ key) here.
# Never use NEXT_PUBLIC_ and never place this in apps/host/.env.local.
SUPABASE_SERVICE_ROLE_KEY=

# Local CMS administrator login. Use a unique, strong password and a random
# ADMIN_SECRET_KEY of at least 32 characters. These values remain server-only.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_a_strong_local_dev_password
ADMIN_SECRET_KEY=replace_with_a_random_secret_of_at_least_32_characters

# CMS does not need Firebase or payment gateway credentials.
