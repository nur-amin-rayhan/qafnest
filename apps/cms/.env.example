# Supabase Public Configuration (Exposed to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here
# For older projects only, the legacy anon key is also supported as a fallback:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
NEXT_PUBLIC_SUPABASE_OTP_LENGTH=6

# WhatsApp OTP is sent through Supabase Auth. Enable Phone auth and configure
# a Twilio/Twilio Verify WhatsApp sender in the Supabase dashboard; no sender
# secret belongs in this browser-facing environment file.

# Next.js App Base URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Firebase Web Configuration (Client-side Phone Auth)
# Obtain these values from your Firebase Console under Project Settings > General > Your apps (Web app)

# Payment methods currently fail closed. Setting provider labels alone does not
# activate a gateway; server-side adapters and verified callbacks are required.
