# Browser-safe Supabase configuration. Point this at the isolated DEV project.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here
NEXT_PUBLIC_SUPABASE_OTP_LENGTH=6

# Admin Operations Portal URL and ecosystem navigation links.
PORT=3003
NEXT_PUBLIC_SITE_URL=http://localhost:3003
NEXT_PUBLIC_GUEST_URL=http://localhost:3000
NEXT_PUBLIC_HOST_PORTAL_URL=http://localhost:3001
NEXT_PUBLIC_CMS_PORTAL_URL=http://localhost:3002
NEXT_PUBLIC_ADMIN_PORTAL_URL=http://localhost:3003

# Server-only key used by the protected Admin operations and approval API.
# Paste the test project's service_role key here.
# Never use NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Local Super Administrator login. Use a unique, strong password and a random
# ADMIN_SECRET_KEY of at least 32 characters. These values remain server-only.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_a_strong_local_dev_password
ADMIN_SECRET_KEY=replace_with_a_random_secret_of_at_least_32_characters
PORTAL_SESSION_SECRET=

# Server-side payment refund/sync credentials (keep test mode in dev).
MYFATOORAH_API_KEY=
MYFATOORAH_BASE_URL=https://apitest.myfatoorah.com/v2

# ZATCA Phase 2 signing & Helpline OTP verification (keep simulation/test toggles false in prod).
ZATCA_PRIVATE_KEY=
ZATCA_ALLOW_SIMULATION=false
HELPLINE_SMS_WEBHOOK_URL=
HELPLINE_SMS_API_KEY=
HELPLINE_ALLOW_TEST_OTP=false
TRUST_CF_CONNECTING_IP=false

# Admin does not need browser Firebase credentials.
