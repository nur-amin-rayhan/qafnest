# Browser-safe Supabase configuration. Point this at the isolated DEV project.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here
NEXT_PUBLIC_SUPABASE_OTP_LENGTH=6

# Private server credential. Required for secure booking persistence and
# verified payment callbacks. Can be the legacy service_role JWT or a modern
# Supabase secret API key. Never prefix it with NEXT_PUBLIC_ or expose it to Host.
SUPABASE_SERVICE_ROLE_KEY=

# Guest app URL and the other local apps.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_GUEST_URL=http://localhost:3000
NEXT_PUBLIC_HOST_PORTAL_URL=http://localhost:3001
NEXT_PUBLIC_CMS_PORTAL_URL=http://localhost:3002
NEXT_PUBLIC_ADMIN_PORTAL_URL=http://localhost:3003

# Firebase Web app configuration (browser-visible; these are not admin secrets).
# Required for the current Firebase phone sign-in flow. Configure Firebase and
# Supabase's Firebase third-party auth integration for the same project.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# Supabase Auth OTP delivery (SMS/WhatsApp) is configured in the Supabase
# dashboard under Authentication providers; sender credentials do not belong here.

# MyFatoorah server-side payment configuration. Keep test mode enabled in dev.
# Do not use a production API token for local E2E checks.
MYFATOORAH_API_KEY=
MYFATOORAH_IS_TEST=true
MYFATOORAH_BASE_URL=https://apitest.myfatoorah.com/v2
MYFATOORAH_WEBHOOK_SECRET=
MYFATOORAH_DEFAULT_EMAIL=
# Optional public return URLs; when blank, the app builds them from SITE_URL.
MYFATOORAH_CALLBACK_URL=
MYFATOORAH_ERROR_URL=
# Comma-separated list of trusted redirect/callback origins in production.
ALLOWED_APP_ORIGINS=

# Optional Samsung Pay Web Checkout + MyFatoorah v3 SAMSUNG_PAY onboarding.
# Requires a Samsung Pay Portal Service ID and MyFatoorah CSR/PPC activation.
MYFATOORAH_SAMSUNG_PAY_ENABLED=false
NEXT_PUBLIC_SAMSUNG_PAY_SERVICE_ID=
NEXT_PUBLIC_SAMSUNG_PAY_ENV=STAGE

# Server-side auth, Firebase verification & portal session security.
FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
PORTAL_SESSION_SECRET=replace_with_a_random_secret_of_at_least_32_characters
ENCRYPTION_KEY=

# Cloudflare Turnstile bot protection on public contact forms (optional in dev).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Outbound email delivery: prefers Resend API when configured, otherwise falls back to SMTP or Gmail.
RESEND_API_KEY=
RESEND_FROM_EMAIL=support@qafnest.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
GMAIL_USER=qafnest@gmail.com
GMAIL_APP_PASSWORD=
CONTACT_FROM_EMAIL=qafnest@gmail.com

# Reverse-proxy & development-only toggles (keep false in production unless behind Cloudflare).
TRUST_CF_CONNECTING_IP=false
HELPLINE_ALLOW_TEST_OTP=false


