# Browser-safe Supabase configuration. Point this at the isolated DEV project.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here
NEXT_PUBLIC_SUPABASE_OTP_LENGTH=6

# Host app URL and ecosystem navigation links.
NEXT_PUBLIC_SITE_URL=http://localhost:3001
NEXT_PUBLIC_GUEST_URL=http://localhost:3000
NEXT_PUBLIC_HOST_PORTAL_URL=http://localhost:3001
NEXT_PUBLIC_CMS_PORTAL_URL=http://localhost:3002
NEXT_PUBLIC_ADMIN_PORTAL_URL=http://localhost:3003

# Firebase Web app configuration (browser-visible; these are not admin secrets).
# Required for the current Firebase phone sign-in flow. Configure Firebase and
# Supabase's Firebase third-party auth integration for the same project.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# Google Maps Platform API Keys (browser loader + optional server-side geocoding).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Server-only Firebase project & signed portal session secret (min 32 chars).
FIREBASE_PROJECT_ID=
PORTAL_SESSION_SECRET=replace_with_a_random_secret_of_at_least_32_characters

# Server-only Supabase service credential for authenticated Host API routes.
# Required server-side after verifyHostSession() + host_id checks because Firebase OTP
# hosts do not hold native Supabase RLS JWTs. Never prefix with NEXT_PUBLIC_ and never
# add payment or admin secrets (MYFATOORAH_*, ADMIN_SECRET_KEY) to apps/host.
SUPABASE_SERVICE_ROLE_KEY=

# Supabase Auth OTP delivery (SMS/WhatsApp) is configured in the Supabase
# dashboard under Authentication providers; sender credentials do not belong here.
