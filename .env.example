# Shared, browser-safe Supabase configuration.
# Use the isolated DEVELOPMENT Supabase project while validating this workspace.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here
NEXT_PUBLIC_SUPABASE_OTP_LENGTH=6

# App URLs used by navigation, CORS, and authentication redirects.
# Production domains (Subdomain Isolation):
#   Guest: https://qafnest.com
#   Host Portal: https://business.qafnest.com
#   CMS Portal: https://cms.qafnest.com
#   Admin Portal: https://admin.qafnest.com
NEXT_PUBLIC_GUEST_URL=http://localhost:3000
NEXT_PUBLIC_HOST_PORTAL_URL=http://localhost:3001
NEXT_PUBLIC_CMS_PORTAL_URL=http://localhost:3002
NEXT_PUBLIC_ADMIN_PORTAL_URL=http://localhost:3003

# Contact Form & Inquiry Gmail SMTP (used by Guest /api/contact and CMS Contact & Gmail Inbox)
# Generate a 16-character App Password at https://myaccount.google.com/apppasswords (requires 2FA)
GMAIL_USER=qafnest@gmail.com
GMAIL_APP_PASSWORD=
CONTACT_FROM_EMAIL=qafnest@gmail.com

# Google Maps Platform (Interactive Map & Geocoding)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Root .env.example intentionally contains no service-role, payment, or admin secrets.
# Put server-only secrets in the app-specific files:
#   apps/guest/.env.local  -> SUPABASE_SERVICE_ROLE_KEY, MYFATOORAH_API_KEY
#   apps/cms/.env.local    -> SUPABASE_SERVICE_ROLE_KEY, ADMIN_PASSWORD, ADMIN_SECRET_KEY
# Do not put privileged keys in apps/host/.env.local or any NEXT_PUBLIC_* variable.
# For remote migrations, use `supabase login` and the project database password
# through the Supabase CLI prompt; neither is needed by the Next.js apps.
