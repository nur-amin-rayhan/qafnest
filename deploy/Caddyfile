# Caddy reverse proxy configuration for QafNest on Hetzner VPS (auto HTTPS via Let's Encrypt)
# Copy to /etc/caddy/Caddyfile and reload with: sudo systemctl reload caddy

www.qafnest.com {
	redir https://qafnest.com{uri} permanent
}

qafnest.com {
	encode gzip zstd

	@admin path /admin /admin/*
	handle @admin {
		reverse_proxy 127.0.0.1:3003
	}

	@cms path /cms /cms/*
	handle @cms {
		reverse_proxy 127.0.0.1:3002
	}

	handle {
		reverse_proxy 127.0.0.1:3000
	}
}

business.qafnest.com {
	encode gzip zstd
	reverse_proxy 127.0.0.1:3001
}
