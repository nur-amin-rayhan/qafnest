# Caddy reverse proxy configuration for QafNest on Hetzner VPS (Subdomain Isolation)
# Copy to /etc/caddy/Caddyfile and reload with: sudo systemctl reload caddy

www.qafnest.com {
	redir https://qafnest.com{uri} permanent
}

qafnest.com {
	encode gzip zstd
	reverse_proxy 127.0.0.1:3000
}

business.qafnest.com {
	encode gzip zstd
	reverse_proxy 127.0.0.1:3001
}

cms.qafnest.com {
	encode gzip zstd
	reverse_proxy 127.0.0.1:3002
}

admin.qafnest.com {
	encode gzip zstd
	reverse_proxy 127.0.0.1:3003
}
