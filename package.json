{
  "name": "qafnest-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev-all.mjs",
    "dev:guest": "npm --prefix apps/guest run dev",
    "dev:host": "npm --prefix apps/host run dev",
    "dev:cms": "npm --prefix apps/cms run dev",
    "build": "npm --prefix apps/guest run build && npm --prefix apps/host run build && npm --prefix apps/cms run build",
    "build:guest": "npm --prefix apps/guest run build",
    "build:host": "npm --prefix apps/host run build",
    "build:cms": "npm --prefix apps/cms run build",
    "lint": "npm --prefix apps/guest run lint && npm --prefix apps/host run lint && npm --prefix apps/cms run lint"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "firebase": "^13.1.0",
    "framer-motion": "^14.7.1",
    "lenis": "^1.3.27",
    "lucide-react": "^1.63.0",
    "next": "14.2.35",
    "react": "^18",
    "react-dom": "^18"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  }
}
