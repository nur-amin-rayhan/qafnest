{
  "name": "qafnest-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev-all.mjs",
    "dev:guest": "npm --prefix apps/guest run dev",
    "dev:host": "npm --prefix apps/host run dev",
    "dev:cms": "npm --prefix apps/cms run dev",
    "dev:admin": "npm --prefix apps/admin run dev",
    "build": "npm --prefix apps/guest run build && npm --prefix apps/host run build && npm --prefix apps/cms run build && npm --prefix apps/admin run build",
    "build:guest": "npm --prefix apps/guest run build",
    "build:host": "npm --prefix apps/host run build",
    "build:cms": "npm --prefix apps/cms run build",
    "build:admin": "npm --prefix apps/admin run build",
    "lint": "npm --prefix apps/guest run lint && npm --prefix apps/host run lint && npm --prefix apps/cms run lint && npm --prefix apps/admin run lint",
    "design:audit": "node scripts/design-audit.mjs",
    "design:fix": "node scripts/design-audit.mjs --fix",
    "test:e2e": "node scripts/e2e-finance-test.mjs"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "@types/node": "^20",
    "typescript": "^5"
  }
}
